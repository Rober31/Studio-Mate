# --- Database -------------------------------------------------------------
# Production (Vercel): a Turso database. Create it in Frankfurt (aws-eu-central-1)
# to match the Vercel function region (fra1) in vercel.json.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Local development: leave the Turso values empty to use a local file.
DATABASE_PATH=./data/studiomate.db

# --- Security ---------------------------------------------------------------
# Required in production: the code asked on the first-run setup screen,
# so nobody else can claim a freshly deployed instance.
SETUP_CODE=
# Required on Vercel: protects the daily maintenance job (/api/cron/jobs).
CRON_SECRET=

# --- Optional ---------------------------------------------------------------
# Enables AI message drafting. Without it StudioMate uses its safe fixed templates.
ANTHROPIC_API_KEY=
